# Copy to .env for local dev. In production set these in the Vercel dashboard
# (Project → Settings → Environment Variables), NOT in a committed file.

# --- Supabase: browser (must be a real https:// project URL, never localhost) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon / publishable key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# --- Supabase: server (SSR + server functions) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<anon / publishable key>
SUPABASE_SERVICE_ROLE_KEY=<service role key — server only, keep secret>

# --- Admin panel unlock (/admin) ---
# The password typed into the admin unlock form. Without this the server throws
# "Admin password not configured" and no password will ever be accepted.
ADMIN_UNLOCK_PASSWORD=<choose a strong password>
ADMIN_UNLOCK_PASSWORD_SECONDARY=
